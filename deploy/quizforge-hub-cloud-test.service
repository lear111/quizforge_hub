[Unit]
Description=QuizForge Hub isolated cloud preview (synthetic data)
After=network.target

[Service]
Type=simple
User=quizforge-cloud-test
Group=quizforge-cloud-test
WorkingDirectory=/opt/quizforge-hub-cloud-test/current
ExecStart=/opt/quizforge-node/bin/node /opt/quizforge-hub-cloud-test/current/scripts/cloud-preview.mjs
Environment=PREVIEW_SYNTHETIC_DATA=1
Environment=DATA_DIR=/var/lib/quizforge-hub-cloud-test
Environment=PREVIEW_PORT=4320
Environment=PREVIEW_ORIGIN=http://localhost:4321
Environment=NODE_ENV=production
Environment=CLOUD_RUNTIME_DIR=/opt/quizforge-hub-cloud-test/current/.runtime/web-current
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/quizforge-hub-cloud-test
UMask=0077
MemoryHigh=384M
MemoryMax=512M
TasksMax=96

[Install]
WantedBy=multi-user.target
