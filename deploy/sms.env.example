# Copy to /etc/quizforge-hub/sms.env (root-owned, mode 600).
# Only the main Hub needs these settings. Do not copy credentials to practice,
# clients, public/, Git, a deployment archive, or a chat message.
ALIYUN_SMS_ENABLED=0
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# Use the paired system-provided signature and login/registration template.
# The template must accept ${code} and ${min} variables.
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# Stable independent random secret, at least 32 characters. Example generation:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMS_CODE_PEPPER=
# Rolling 24-hour paid send reservation ceiling (including failed/time-out sends).
SMS_DAILY_LIMIT=100
# Reuse the existing real Turnstile keys in mail.env. If mail is not configured,
# supply TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY privately here as well.
