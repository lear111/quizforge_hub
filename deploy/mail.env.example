# Copy to /etc/quizforge-hub/mail.env (root-owned, mode 600), never to the public/ folder.
# Keep disabled until real captcha keys and a receipt test are complete.
TENCENT_SES_ENABLED=0
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_FROM=noreply@mail.treenewbee.cloud
TENCENT_SES_TEMPLATE_ID=224355
# Generate a stable random value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value invalidates pending codes and resets the identity keys used by email quotas.
EMAIL_CODE_PEPPER=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Dedicated admin review alerts; create and approve deploy/review-email-template.html first.
REVIEW_EMAIL=
TENCENT_SES_REVIEW_TEMPLATE_ID=

# Temporary public homepage. Disable to restore the community homepage.
DOWNLOAD_NOTICE_ENABLED=0
DOWNLOAD_NOTICE_URL=
DOWNLOAD_NOTICE_CODE=
